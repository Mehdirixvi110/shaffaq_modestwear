# Canonical application origin. Vercel production must use the exact HTTPS origin
# with no trailing slash, path, query, fragment, or embedded credentials.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
PORT=3000

# Provider switches. Local single-host development can use sqlite/local.
# Vercel production must use postgres/supabase.
DATABASE_PROVIDER=sqlite
MEDIA_PROVIDER=local

# Local SQLite and filesystem media paths.
SQLITE_PATH=.data/db/shaffaq.sqlite
MEDIA_ROOT=.data/media

# Independent random values containing at least 32 bytes each.
SESSION_SECRET=
CSRF_SECRET=

# Supabase PostgreSQL runtime URL: transaction pooler on port 6543.
# Keep credentials URL-encoded and never expose this value to the browser.
DATABASE_URL=

# Command-only Supabase PostgreSQL URL: session pooler on port 5432.
# Configure this only where controlled migrate/seed/bootstrap commands run.
MIGRATION_DATABASE_URL=

# Server-only Supabase Storage configuration. The bucket must already be public,
# limited to JPEG/PNG/WebP, and capped at 10 MiB per object.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shaffaq-media

# Command-only bootstrap values. Set a unique 14+ character password, run the
# matching bootstrap command once, then clear ADMIN_INITIAL_PASSWORD immediately.
ADMIN_EMAIL=admin@shaffaqmodestwear.com
ADMIN_INITIAL_PASSWORD=
