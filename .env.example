# Canonical application origin. Production must use the exact HTTPS origin with no
# trailing slash, path, query, fragment, or embedded credentials. For local SQLite
# development override both with http://localhost:3000 (see README "Local SQLite setup").
APP_ORIGIN=https://shaffaqmodestwear.pk
NEXT_PUBLIC_APP_ORIGIN=https://shaffaqmodestwear.pk
PORT=3000

# Provider switches. Local single-host development can use sqlite/local.
# Self-hosted cPanel production (Phusion Passenger) uses DATABASE_PROVIDER=sqlite with
# SELF_HOSTED_SQLITE=1 and MEDIA_PROVIDER=local OR supabase — see docs/CPANEL_DEPLOYMENT.md.
# Recommended hybrid for a small host: sqlite + supabase keeps the tiny text database on
# the server and offloads the heavy image files to Supabase Storage. Vercel production, if
# ever used, must use postgres/supabase.
DATABASE_PROVIDER=sqlite
MEDIA_PROVIDER=local

# Self-hosted production opt-in. Set to 1 ONLY on the self-hosted production host to permit
# DATABASE_PROVIDER=sqlite with MEDIA_PROVIDER=local OR supabase in production. It still
# enforces an exact-HTTPS APP_ORIGIN and present, >=32-byte, distinct SESSION_SECRET and
# CSRF_SECRET, and it is ignored on Vercel. For the supabase-media hybrid also set the
# SUPABASE_URL / SUPABASE_SECRET_KEY / SUPABASE_STORAGE_BUCKET below. Leave empty for dev/Vercel.
SELF_HOSTED_SQLITE=

# Local SQLite and filesystem media paths. In self-hosted production these MUST be
# absolute paths on persistent storage OUTSIDE the application root and .next (see
# docs/CPANEL_DEPLOYMENT.md) so a redeploy never overwrites the database or media.
SQLITE_PATH=.data/db/shaffaq.sqlite
MEDIA_ROOT=.data/media

# Independent random values containing at least 32 bytes each.
SESSION_SECRET=
CSRF_SECRET=

# Supabase PostgreSQL runtime URL: transaction pooler on port 6543.
# Keep credentials URL-encoded and never expose this value to the browser.
DATABASE_URL=

# Command-only Supabase PostgreSQL URL: session pooler on port 5432.
# Configure this only where controlled migrate/seed/bootstrap commands run.
MIGRATION_DATABASE_URL=

# Server-only Supabase Storage configuration. Used by the Vercel (postgres) profile AND
# the self-hosted sqlite + supabase-media hybrid. The bucket must already be public,
# limited to JPEG/PNG/WebP, and capped at 10 MiB per object.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shaffaq-media

# Command-only bootstrap values. Set a unique 14+ character password, run the
# matching bootstrap command once, then clear ADMIN_INITIAL_PASSWORD immediately.
ADMIN_EMAIL=shaffaqmodestwear@gmail.com
ADMIN_INITIAL_PASSWORD=

# Online payment channel (Safepay). Server-only secrets. The online option is
# shown and accepted ONLY when all three are present and non-empty; otherwise the
# storefront runs COD-only. No real value belongs in version control.
SAFEPAY_ENVIRONMENT=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Admin password recovery email (Gmail SMTP). Required ONLY for the admin
# "Forgot password" flow. To activate:
#   1. Enable 2-Step Verification on the Google account (shaffaqmodestwear@gmail.com).
#   2. Google Account > Security > App passwords > generate a 16-char password.
#   3. Set SMTP_PASS to that App Password (NOT the Gmail login password).
# Host/port default to Gmail SSL; you normally only set SMTP_USER + SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=shaffaqmodestwear@gmail.com
SMTP_PASS=
SMTP_FROM=SHAFFAQ <shaffaqmodestwear@gmail.com>

# Google sign-in for the admin (OAuth 2.0). Optional but recommended for easy login.
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# Authorized redirect URIs:
#   http://127.0.0.1:3000/api/auth/google/callback   (local dev)
#   https://shaffaqmodestwear.pk/api/auth/google/callback   (production)
# Only a Google account whose email matches an existing ADMIN user can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
