# Local single-host defaults
APP_ORIGIN=http://localhost:3000
PORT=3000
SQLITE_PATH=.data/db/shaffaq.sqlite
MEDIA_ROOT=.data/media
SESSION_SECRET=
CSRF_SECRET=

# Optional public configuration; persisted admin settings take precedence
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Command-only bootstrap values. Do not store real values in this file.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Vercel/Supabase production values. Never commit real credentials.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shaffaq-media
MEDIA_PROVIDER=local
